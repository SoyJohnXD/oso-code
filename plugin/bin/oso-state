#!/usr/bin/env bash
# Runtime state for oso-code hooks. Flat key=value lines, one file per
# REPOSITORY — resolved from the directory this runs in — stored outside any
# project so repos stay clean. The session is still named: it is what the audit
# trail records every line under, and what the teardown reads back to find the
# state a session armed.
#
# Writes take a portable mkdir-lock and publish with a single atomic mv, so
# concurrent writers can never corrupt or partially overwrite the state.
#
# Usage:
#   oso-state --session <id> set key=value [key=value ...]
#   oso-state --session <id> get key
#   oso-state --session <id> show
#   oso-state --session <id> clear
#   oso-state --session <id> event <type> [detail]
#   oso-state --session <id> approve-plan <sha256>
#   oso-state --session <id> cancel-plan <sha256>
#   oso-state handoff publish --slice <id> --attempt <n> --agent-id <id> --agent-type <type> --hook-session <id>
#   oso-state handoff wait --slice <id> --attempt <n> --agent-id <id> --agent-type <type> --timeout <seconds>
#   oso-state handoff consume --slice <id> --attempt <n> --agent-id <id> --agent-type <type>
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$BIN_DIR/../hooks/lib.sh"

usage() {
  cat >&2 <<'EOF'
usage: oso-state --session <id> set key=value [key=value ...]
       oso-state --session <id> get key
       oso-state --session <id> show
       oso-state --session <id> clear
       oso-state --session <id> event <type> [detail]
       oso-state --session <id> approve-plan <sha256>
       oso-state --session <id> cancel-plan <sha256>
       oso-state handoff publish --slice <id> --attempt <n> --agent-id <id> --agent-type <type> --hook-session <id>
       oso-state handoff wait --slice <id> --attempt <n> --agent-id <id> --agent-type <type> --timeout <seconds>
       oso-state handoff consume --slice <id> --attempt <n> --agent-id <id> --agent-type <type>

The SubagentStop hook publishes a provenance receipt, never a verdict. wait is
bounded and consume is one-shot. Handoff attempts start at 1 and timeout must
be between 0 and 600 seconds.
EOF
  exit 1
}

raw_session_id=""
session_id=""
if [ "${1:-}" = handoff ]; then
  action=handoff
  shift
else
  [ "${1:-}" = "--session" ] || usage
  raw_session_id="${2:-}"
  session_id="$(sanitize_session "$raw_session_id")"
  [ -n "$session_id" ] || usage
  shift 2
  action="${1:-}"
  shift || true
fi

state_file="$(state_file_for "$PWD")"
lock_dir="${state_file}.lock"
# A writer killed mid-write leaves its lock forever; reclaim it after this long.
lock_stale_seconds=30

lock_is_stale() {
  local held_for
  held_for="$(seconds_since_modified "$lock_dir")" || return 1
  [ "$held_for" -ge "$lock_stale_seconds" ]
}

acquire_lock() {
  local tries=0 reclaimed=false
  until mkdir "$lock_dir" 2>/dev/null; do
    if [ "$reclaimed" = false ] && lock_is_stale; then
      # A SIGKILL'd writer never runs its EXIT trap — reclaim the stale lock once.
      rmdir "$lock_dir" 2>/dev/null || true
      reclaimed=true
      continue
    fi
    tries=$((tries + 1))
    if [ "$tries" -gt 200 ]; then
      echo "oso-state: could not acquire lock for session ${session_id}" >&2
      exit 1
    fi
    sleep 0.05
  done
  trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT
}

# A SubagentStop hook, not the delegated agent, publishes this receipt. That is
# what lets reviewer roles remain read-only while the host still leaves durable
# completion evidence. The receipt intentionally has no verdict field: the
# message the orchestrator reads remains authoritative.
HANDOFF_MAX_TIMEOUT_SECONDS=600
HANDOFF_TTL_SECONDS=86400
HANDOFF_LOCK_TIMEOUT_SECONDS=2

handoff_fail() {
  echo "oso-state: handoff: $*" >&2
  return 1
}

handoff_valid_name() {
  local value="$1"
  [ "${#value}" -ge 1 ] && [ "${#value}" -le 128 ] &&
    [[ "$value" =~ ^[a-zA-Z0-9][a-zA-Z0-9._:-]*$ ]]
}

handoff_valid_opaque_id() {
  local value="$1"
  [ "${#value}" -ge 1 ] && [ "${#value}" -le 256 ] &&
    [[ "$value" =~ ^[a-zA-Z0-9._:/-]+$ ]]
}

handoff_valid_attempt() {
  local value="$1"
  [[ "$value" =~ ^[1-9][0-9]{0,8}$ ]]
}

handoff_valid_timeout() {
  local value="$1"
  [[ "$value" =~ ^(0|[1-9][0-9]{0,2})$ ]] &&
    [ "$value" -le "$HANDOFF_MAX_TIMEOUT_SECONDS" ]
}

handoff_digest_value() {
  local value="$1" digest
  digest="$(printf '%s' "$value" |
    { sha256sum 2>/dev/null || shasum -a 256 2>/dev/null; })" || digest=""
  digest="${digest%% *}"
  [ -n "$digest" ] || handoff_fail "cannot digest the agent id (no sha256sum or shasum)"
  printf '%s' "$digest"
}

handoff_receipt_valid() {
  local path="$1" lines unknown
  [ -f "$path" ] && [ -r "$path" ] && [ ! -L "$path" ] || return 1
  lines="$(wc -l < "$path" | tr -d '[:space:]')"
  [ "$lines" = 6 ] || return 1
  unknown="$(grep -Ev '^(version|hook_session|slice|attempt|agent_id|agent_type)=' "$path" || true)"
  [ -z "$unknown" ] || return 1
  [ "$(grep -c '^version=1$' "$path" || true)" = 1 ] || return 1
  for key in hook_session slice attempt agent_id agent_type; do
    [ "$(grep -c "^${key}=" "$path" || true)" = 1 ] || return 1
  done
  grep -Eq '^attempt=[1-9][0-9]{0,8}$' "$path" || return 1
}

handoff_watermark_valid() {
  local path="$1" lines unknown
  [ -f "$path" ] && [ -r "$path" ] && [ ! -L "$path" ] || return 1
  lines="$(wc -l < "$path" | tr -d '[:space:]')"
  [ "$lines" = 2 ] || return 1
  unknown="$(grep -Ev '^(version|attempt)=' "$path" || true)"
  [ -z "$unknown" ] || return 1
  [ "$(grep -c '^version=1$' "$path" || true)" = 1 ] || return 1
  [ "$(grep -c '^attempt=' "$path" || true)" = 1 ] || return 1
  grep -Eq '^attempt=[1-9][0-9]{0,8}$' "$path"
}

handoff_receipt_matches() {
  local path="$1" expected_slice="$2" expected_attempt="$3"
  local expected_agent_id="$4" expected_agent_type="$5"
  handoff_receipt_valid "$path" &&
    grep -qxF "slice=${expected_slice}" "$path" &&
    grep -qxF "attempt=${expected_attempt}" "$path" &&
    grep -qxF "agent_id=${expected_agent_id}" "$path" &&
    grep -qxF "agent_type=${expected_agent_type}" "$path"
}

handoff_attempt_from() {
  state_value "$1" attempt
}

handoff_lock_acquire() {
  local now
  until mkdir "$handoff_lock_dir" 2>/dev/null; do
    now="$(date +%s)"
    [ "$now" -lt "$handoff_lock_deadline" ] ||
      handoff_fail "could not acquire receipt lock for agent ${handoff_agent_id} before the bound"
    sleep 0.05
  done
  handoff_lock_held=true
}

handoff_lock_release() {
  if [ "${handoff_lock_held:-false}" = true ]; then
    rmdir "$handoff_lock_dir" 2>/dev/null || true
    handoff_lock_held=false
  fi
}

handoff_cleanup() {
  handoff_lock_release
  [ -z "${handoff_tmp:-}" ] || rm -f "$handoff_tmp"
  [ -z "${handoff_snapshot:-}" ] || rm -f "$handoff_snapshot"
}

handoff_parse() {
  handoff_slice=""
  handoff_attempt=""
  handoff_agent_id=""
  handoff_agent_type=""
  handoff_hook_session=""
  handoff_timeout=""
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || usage
    case "$1" in
      --slice) [ -z "$handoff_slice" ] || usage; handoff_slice="$2" ;;
      --attempt) [ -z "$handoff_attempt" ] || usage; handoff_attempt="$2" ;;
      --agent-id) [ -z "$handoff_agent_id" ] || usage; handoff_agent_id="$2" ;;
      --agent-type) [ -z "$handoff_agent_type" ] || usage; handoff_agent_type="$2" ;;
      --hook-session) [ -z "$handoff_hook_session" ] || usage; handoff_hook_session="$2" ;;
      --timeout) [ -z "$handoff_timeout" ] || usage; handoff_timeout="$2" ;;
      *) usage ;;
    esac
    shift 2
  done
  handoff_valid_name "$handoff_slice" || handoff_fail "invalid slice id"
  handoff_valid_attempt "$handoff_attempt" || handoff_fail "attempt must be an integer from 1 to 999999999"
  handoff_valid_opaque_id "$handoff_agent_id" || handoff_fail "invalid agent id"
  handoff_valid_name "$handoff_agent_type" || handoff_fail "invalid agent type"
}

handoff_paths() {
  handoff_repo_id="${state_file##*/}"
  handoff_repo_id="${handoff_repo_id%.state}"
  handoff_agent_key="$(handoff_digest_value "$handoff_agent_id")"
  handoff_dir="${OSO_STATE_DIR}/.handoffs/${handoff_repo_id}"
  handoff_receipt="${handoff_dir}/${handoff_agent_key}.receipt"
  handoff_watermark="${handoff_dir}/${handoff_agent_key}.watermark"
  handoff_lock_dir="${handoff_dir}/${handoff_agent_key}.lock"
  handoff_lock_held=false
  handoff_tmp=""
  handoff_snapshot=""
}

# Sweep every expired lane in this repository before taking the caller's own
# lock. A foreign lane is touched only while its own lock can be created without
# waiting; a live or orphaned lock is never reclaimed. Names outside this closed
# set are ignored, and the file is revalidated after the lock closes the race.
handoff_global_sweep() {
  local artifact name key sweep_lock age
  for artifact in "${handoff_dir}"/* "${handoff_dir}"/.*; do
    [ -e "$artifact" ] || continue
    name="${artifact##*/}"
    key=""
    if [[ "$name" =~ ^([0-9a-f]{64})\.(receipt|consumed|watermark)$ ]]; then
      key="${BASH_REMATCH[1]}"
    elif [[ "$name" =~ ^\.([0-9a-f]{64})\.(receipt|consuming|watermark)\.[a-zA-Z0-9]{6}$ ]]; then
      key="${BASH_REMATCH[1]}"
    else
      continue
    fi
    sweep_lock="${handoff_dir}/${key}.lock"
    (
      mkdir "$sweep_lock" 2>/dev/null || exit 0
      trap 'rmdir "$sweep_lock" 2>/dev/null || true' EXIT
      [ -f "$artifact" ] && [ ! -L "$artifact" ] || exit 0
      age="$(seconds_since_modified "$artifact")" || exit 0
      [ "$age" -ge "$HANDOFF_TTL_SECONDS" ] || exit 0
      rm -f -- "$artifact"
    )
  done
}

handoff_prune_locked() {
  local artifact age
  for artifact in "$handoff_receipt" "$handoff_watermark" \
    "${handoff_dir}/.${handoff_agent_key}.receipt."* \
    "${handoff_dir}/.${handoff_agent_key}.consuming."* \
    "${handoff_dir}/.${handoff_agent_key}.watermark."*; do
    [ -e "$artifact" ] || continue
    [ -f "$artifact" ] && [ ! -L "$artifact" ] ||
      handoff_fail "handoff artifact is not a regular file at ${artifact}"
    age="$(seconds_since_modified "$artifact")" ||
      handoff_fail "cannot determine receipt age at ${artifact}"
    if [ "$age" -ge "$HANDOFF_TTL_SECONDS" ]; then
      rm -f "$artifact"
    fi
  done
}

handoff_write_watermark() {
  local recorded
  if [ -e "$handoff_watermark" ]; then
    handoff_watermark_valid "$handoff_watermark" ||
      handoff_fail "malformed watermark at ${handoff_watermark}"
    recorded="$(handoff_attempt_from "$handoff_watermark")"
    [ "$recorded" -le "$handoff_attempt" ] ||
      handoff_fail "watermark attempt ${recorded} supersedes receipt attempt ${handoff_attempt}"
    [ "$recorded" != "$handoff_attempt" ] || return 0
  fi
  handoff_tmp="$(mktemp "${handoff_dir}/.${handoff_agent_key}.watermark.XXXXXX")"
  printf 'version=1\nattempt=%s\n' "$handoff_attempt" > "$handoff_tmp"
  mv "$handoff_tmp" "$handoff_watermark"
  handoff_tmp=""
}

handoff_publish() (
  handoff_parse "$@"
  [ -z "$handoff_timeout" ] || usage
  handoff_valid_opaque_id "$handoff_hook_session" || handoff_fail "invalid hook session id"
  handoff_paths
  trap handoff_cleanup EXIT
  ( umask 077; mkdir -p "$handoff_dir" )
  chmod 700 "$handoff_dir" 2>/dev/null || handoff_fail "cannot protect receipt directory"
  handoff_global_sweep
  # Drain stdin: the hook owns and validates the message envelope. json_field's
  # decoded string is not a byte-stable provenance source, so no digest belongs
  # in this file rail.
  cat >/dev/null
  handoff_lock_deadline="$(($(date +%s) + HANDOFF_LOCK_TIMEOUT_SECONDS))"
  handoff_lock_acquire
  handoff_prune_locked
  newest=0
  if [ -e "$handoff_receipt" ]; then
    handoff_receipt_valid "$handoff_receipt" || handoff_fail "malformed receipt at ${handoff_receipt}"
    existing_attempt="$(handoff_attempt_from "$handoff_receipt")"
    [ "$existing_attempt" -le "$newest" ] || newest="$existing_attempt"
  fi
  if [ -e "$handoff_watermark" ]; then
    handoff_watermark_valid "$handoff_watermark" || handoff_fail "malformed watermark at ${handoff_watermark}"
    existing_attempt="$(handoff_attempt_from "$handoff_watermark")"
    [ "$existing_attempt" -le "$newest" ] || newest="$existing_attempt"
  fi
  if [ "$handoff_attempt" -lt "$newest" ]; then
    handoff_fail "stale publish for slice ${handoff_slice}: attempt ${handoff_attempt}, newest ${newest}"
  fi
  if [ "$handoff_attempt" -eq "$newest" ]; then
    if [ -f "$handoff_receipt" ] &&
       handoff_receipt_matches "$handoff_receipt" "$handoff_slice" "$handoff_attempt" "$handoff_agent_id" "$handoff_agent_type" &&
       grep -qxF "hook_session=${handoff_hook_session}" "$handoff_receipt"; then
      exit 0
    fi
    handoff_fail "attempt ${handoff_attempt} for slice ${handoff_slice} was already published or consumed"
  fi

  handoff_tmp="$(mktemp "${handoff_dir}/.${handoff_agent_key}.receipt.XXXXXX")"
  {
    printf 'version=1\n'
    printf 'hook_session=%s\n' "$handoff_hook_session"
    printf 'slice=%s\n' "$handoff_slice"
    printf 'attempt=%s\n' "$handoff_attempt"
    printf 'agent_id=%s\n' "$handoff_agent_id"
    printf 'agent_type=%s\n' "$handoff_agent_type"
  } > "$handoff_tmp"
  mv "$handoff_tmp" "$handoff_receipt"
  handoff_tmp=""
  # Receipt first: a crash may leave completion evidence without its watermark,
  # which consume repairs. The inverse would reserve an attempt whose receipt
  # was never published and make the host unable to retry it.
  handoff_write_watermark
)

handoff_wait() (
  handoff_parse "$@"
  [ -n "$handoff_timeout" ] || usage
  [ -z "$handoff_hook_session" ] || usage
  handoff_valid_timeout "$handoff_timeout" || handoff_fail "timeout must be an integer from 0 to ${HANDOFF_MAX_TIMEOUT_SECONDS}"
  handoff_paths
  trap handoff_cleanup EXIT
  ( umask 077; mkdir -p "$handoff_dir" )
  handoff_global_sweep
  deadline="$(($(date +%s) + handoff_timeout))"
  while :; do
    handoff_lock_deadline="$(($(date +%s) + HANDOFF_LOCK_TIMEOUT_SECONDS))"
    [ "$handoff_lock_deadline" -le "$deadline" ] || handoff_lock_deadline="$deadline"
    handoff_lock_acquire
    handoff_prune_locked
    if [ -e "$handoff_receipt" ]; then
      handoff_receipt_valid "$handoff_receipt" || handoff_fail "malformed receipt at ${handoff_receipt}"
      actual_attempt="$(handoff_attempt_from "$handoff_receipt")"
      [ "$actual_attempt" = "$handoff_attempt" ] ||
        handoff_fail "stale or superseding receipt for slice ${handoff_slice}: expected attempt ${handoff_attempt}, found ${actual_attempt}"
      handoff_receipt_matches "$handoff_receipt" "$handoff_slice" "$handoff_attempt" "$handoff_agent_id" "$handoff_agent_type" ||
        handoff_fail "receipt identity does not match the awaited delegation"
      cat "$handoff_receipt"
      exit 0
    fi
    if [ -e "$handoff_watermark" ]; then
      handoff_watermark_valid "$handoff_watermark" || handoff_fail "malformed watermark at ${handoff_watermark}"
      consumed_attempt="$(handoff_attempt_from "$handoff_watermark")"
      if [ "$consumed_attempt" -ge "$handoff_attempt" ]; then
        handoff_fail "receipt for slice ${handoff_slice} attempt ${handoff_attempt} was already consumed or superseded"
      fi
    fi
    handoff_lock_release
    [ "$(date +%s)" -lt "$deadline" ] ||
      handoff_fail "timed out waiting for slice ${handoff_slice} attempt ${handoff_attempt} after ${handoff_timeout}s"
    sleep 0.05
  done
)

handoff_consume() (
  handoff_parse "$@"
  [ -z "$handoff_timeout" ] || usage
  [ -z "$handoff_hook_session" ] || usage
  handoff_paths
  trap handoff_cleanup EXIT
  [ -d "$handoff_dir" ] || handoff_fail "no receipt for slice ${handoff_slice} attempt ${handoff_attempt}"
  handoff_global_sweep
  handoff_lock_deadline="$(($(date +%s) + HANDOFF_LOCK_TIMEOUT_SECONDS))"
  handoff_lock_acquire
  handoff_prune_locked
  [ -e "$handoff_receipt" ] || handoff_fail "no unconsumed receipt for slice ${handoff_slice} attempt ${handoff_attempt}"
  handoff_receipt_valid "$handoff_receipt" || handoff_fail "malformed receipt at ${handoff_receipt}"
  actual_attempt="$(handoff_attempt_from "$handoff_receipt")"
  [ "$actual_attempt" = "$handoff_attempt" ] ||
    handoff_fail "stale or superseding receipt for slice ${handoff_slice}: expected attempt ${handoff_attempt}, found ${actual_attempt}"
  handoff_receipt_matches "$handoff_receipt" "$handoff_slice" "$handoff_attempt" "$handoff_agent_id" "$handoff_agent_type" ||
    handoff_fail "receipt identity does not match the delegated result"
  handoff_snapshot="$(mktemp "${handoff_dir}/.${handoff_agent_key}.consuming.XXXXXX")"
  cat "$handoff_receipt" > "$handoff_snapshot"
  handoff_write_watermark
  rm -f -- "$handoff_receipt"
  handoff_lock_release
  cat "$handoff_snapshot"
)

case "$action" in
  set)
    [ $# -ge 1 ] || usage
    mkdir -p "$OSO_STATE_DIR"
    acquire_lock
    tmp="$(mktemp "${OSO_STATE_DIR}/.tmp.XXXXXX")"
    [ -f "$state_file" ] && cat "$state_file" > "$tmp"
    # The session goes in beside the caller's keys, last so the flag wins: the
    # file is named after the repository now, and the teardown runs in no
    # directory that could name one — which session armed the state is the only
    # way back to the file it left.
    for pair in "$@" "session=$session_id"; do
      key="${pair%%=*}"
      next="$(mktemp "${OSO_STATE_DIR}/.tmp.XXXXXX")"
      grep -v "^${key}=" "$tmp" > "$next" || true
      printf '%s\n' "$pair" >> "$next"
      mv "$next" "$tmp"
    done
    mv "$tmp" "$state_file"
    log_event "set:$*" "$session_id"
    ;;
  get)
    [ $# -eq 1 ] || usage
    state_value "$state_file" "$1"
    ;;
  show)
    [ -f "$state_file" ] && cat "$state_file" || echo "no state at ${state_file}"
    ;;
  clear)
    mkdir -p "$OSO_STATE_DIR"
    acquire_lock
    rm -f "$state_file"
    log_event clear "$session_id"
    ;;
  event)
    [ $# -ge 1 ] && [ $# -le 2 ] || usage
    # No lock, unlike set and clear: the lock serializes publication of THIS
    # session's state file, while this appends one line to the event log every
    # hook already appends to unlocked and no state file is touched at all.
    log_event "$1" "$session_id" "${2:-}"
    ;;
  approve-plan)
    [ $# -eq 1 ] || usage
    approval_digest="$1"
    [[ "$approval_digest" =~ ^[0-9a-f]{64}$ ]] || {
      echo "oso-state: approve-plan requires one lowercase SHA-256 digest" >&2
      exit 1
    }
    mkdir -p "$OSO_STATE_DIR"
    acquire_lock
    [ -f "$state_file" ] && [ -r "$state_file" ] && [ ! -L "$state_file" ] || {
      echo "oso-state: no readable pending plan approval for session ${session_id}" >&2
      exit 1
    }
    [ "$(state_value "$state_file" session)" = "$session_id" ] || {
      echo "oso-state: pending plan approval belongs to another session" >&2
      exit 1
    }
    [ "$(state_value "$state_file" mode)" = plan ] || {
      echo "oso-state: pending approval is not attached to plan mode state" >&2
      exit 1
    }
    [ "$(state_value "$state_file" plan_approval)" = pending ] || {
      echo "oso-state: plan approval is not pending" >&2
      exit 1
    }
    [ "$(state_value "$state_file" plan_approval_digest)" = "$approval_digest" ] || {
      echo "oso-state: pending plan digest changed before approval" >&2
      exit 1
    }
    tmp="$(mktemp "${OSO_STATE_DIR}/.tmp.XXXXXX")"
    grep -v '^plan_approval=' "$state_file" > "$tmp" || true
    printf 'plan_approval=approved\n' >> "$tmp"
    mv "$tmp" "$state_file"
    log_event plan-approval-approved "$session_id"
    ;;
  cancel-plan)
    [ $# -eq 1 ] || usage
    cancellation_digest="$1"
    [[ "$cancellation_digest" =~ ^[0-9a-f]{64}$ ]] || {
      echo "oso-state: cancel-plan requires one lowercase SHA-256 digest" >&2
      exit 1
    }
    mkdir -p "$OSO_STATE_DIR"
    acquire_lock
    [ -f "$state_file" ] && [ -r "$state_file" ] && [ ! -L "$state_file" ] || {
      echo "oso-state: no readable pending plan approval for session ${session_id}" >&2
      exit 1
    }
    [ "$(state_value "$state_file" session)" = "$session_id" ] || {
      echo "oso-state: pending plan approval belongs to another session" >&2
      exit 1
    }
    [ "$(state_value "$state_file" plan_approval)" = pending ] || {
      echo "oso-state: plan approval is not pending" >&2
      exit 1
    }
    [ "$(state_value "$state_file" plan_approval_digest)" = "$cancellation_digest" ] || {
      echo "oso-state: pending plan digest changed before cancellation" >&2
      exit 1
    }
    rm -f "$state_file"
    log_event plan-approval-cancelled "$session_id"
    ;;
  handoff)
    subaction="${1:-}"
    shift || true
    case "$subaction" in
      publish) handoff_publish "$@" ;;
      wait) handoff_wait "$@" ;;
      consume) handoff_consume "$@" ;;
      *) usage ;;
    esac
    ;;
  *)
    usage
    ;;
esac
