#!/usr/bin/env bash
# Session state for oso-code hooks. Flat key=value lines, one file per session,
# stored outside any project so repos stay clean.
#
# Writes take a portable mkdir-lock and publish with a single atomic mv, so
# concurrent writers can never corrupt or partially overwrite the state.
#
# Usage:
#   oso-state --session <id> set key=value [key=value ...]
#   oso-state --session <id> get key
#   oso-state --session <id> show
#   oso-state --session <id> clear
#   oso-state --session <id> event <type> [detail]
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$BIN_DIR/../hooks/lib.sh"

usage() {
  echo "usage: oso-state --session <id> {set key=value... | get key | show | clear | event <type> [detail]}" >&2
  exit 1
}

[ "${1:-}" = "--session" ] || usage
session_id="$(sanitize_session "${2:-}")"
[ -n "$session_id" ] || usage
shift 2
action="${1:-}"
shift || true

state_file="${OSO_STATE_DIR}/${session_id}.state"
lock_dir="${state_file}.lock"
# A writer killed mid-write leaves its lock forever; reclaim it after this long.
lock_stale_seconds=30

lock_is_stale() {
  local held_for
  held_for="$(seconds_since_modified "$lock_dir")" || return 1
  [ "$held_for" -ge "$lock_stale_seconds" ]
}

acquire_lock() {
  local tries=0 reclaimed=false
  until mkdir "$lock_dir" 2>/dev/null; do
    if [ "$reclaimed" = false ] && lock_is_stale; then
      # A SIGKILL'd writer never runs its EXIT trap — reclaim the stale lock once.
      rmdir "$lock_dir" 2>/dev/null || true
      reclaimed=true
      continue
    fi
    tries=$((tries + 1))
    if [ "$tries" -gt 200 ]; then
      echo "oso-state: could not acquire lock for session ${session_id}" >&2
      exit 1
    fi
    sleep 0.05
  done
  trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT
}

case "$action" in
  set)
    [ $# -ge 1 ] || usage
    mkdir -p "$OSO_STATE_DIR"
    acquire_lock
    tmp="$(mktemp "${OSO_STATE_DIR}/.tmp.XXXXXX")"
    [ -f "$state_file" ] && cat "$state_file" > "$tmp"
    for pair in "$@"; do
      key="${pair%%=*}"
      next="$(mktemp "${OSO_STATE_DIR}/.tmp.XXXXXX")"
      grep -v "^${key}=" "$tmp" > "$next" || true
      printf '%s\n' "$pair" >> "$next"
      mv "$next" "$tmp"
    done
    mv "$tmp" "$state_file"
    log_event "set:$*" "$session_id"
    ;;
  get)
    [ $# -eq 1 ] || usage
    grep "^${1}=" "$state_file" 2>/dev/null | cut -d= -f2- || true
    ;;
  show)
    [ -f "$state_file" ] && cat "$state_file" || echo "no state for session ${session_id}"
    ;;
  clear)
    mkdir -p "$OSO_STATE_DIR"
    acquire_lock
    rm -f "$state_file"
    log_event clear "$session_id"
    ;;
  event)
    [ $# -ge 1 ] && [ $# -le 2 ] || usage
    # No lock, unlike set and clear: the lock serializes publication of THIS
    # session's state file, while this appends one line to the event log every
    # hook already appends to unlocked and no state file is touched at all.
    log_event "$1" "$session_id" "${2:-}"
    ;;
  *)
    usage
    ;;
esac
