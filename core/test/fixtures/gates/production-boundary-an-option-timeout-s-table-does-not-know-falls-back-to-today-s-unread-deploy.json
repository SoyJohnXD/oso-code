{
  "name": "production boundary: an option timeout's table does not know falls back to today's unread deploy",
  "source": [
    {
      "assertion": "assert_equals \"an option timeout's table does not know falls back to today's unread deploy\" \\\n  \"deny\" \"$(verdict_for 'timeout --signal=KILL 10s vercel --prod')\""
    }
  ],
  "gate": "proddeploy",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "auto=running\nauto_change=auto-continuity\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"timeout --signal=KILL 10s vercel --prod\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "past what the production boundary can read"
      ]
    },
    "stderr": "",
    "events_appended": [
      {
        "event": "prod-deploy-denied",
        "command": "timeout --signal=KILL 10s vercel --prod"
      }
    ]
  }
