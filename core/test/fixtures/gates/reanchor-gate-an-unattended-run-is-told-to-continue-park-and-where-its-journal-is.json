{
  "name": "reanchor gate: an unattended run is told to keep going, to park what needs the operator, and where its own journal is",
  "source": [
    {
      "file": "tests/hooks-test.sh",
      "line": 6324,
      "assertion": "oso-state --session \"$SESSION\" set auto=running auto_change=auto-continuity >/dev/null"
    },
    {
      "file": "tests/hooks-test.sh",
      "line": 6336,
      "assertion": "run_hook reanchor-after-compact.sh \"$(reanchor_input compact)\""
    },
    {
      "file": "tests/hooks-test.sh",
      "line": 6332,
      "assertion": "assert_equals \"an unattended run is told to keep going, to park what needs the operator, and where its own journal is\" \\\n  \"|$REANCHOR_CONTINUE_ORDER|park|$AUTO_JOURNAL\" \"$reanchor_unattended_read\""
    }
  ],
  "gate": "reanchor",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=3\nsession=test-session\nauto=running\nauto_change=auto-continuity\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"SessionStart\",\"source\":\"compact\"}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "continue it now rather than waiting",
        "park it per the",
        "runs/{repo}/auto-continuity.log"
      ]
    }
  }
}
