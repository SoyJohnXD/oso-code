{
  "name": "production boundary: a deploy split by backslash-underscore in env's --split-string= value is denied unread",
  "source": [
    {
      "assertion": "assert_equals \"a deploy split by backslash-underscore in env's --split-string= value is denied unread\" \\\n  \"deny\" \"$(verdict_for \\\"env --split-string='vercel\\\\_--prod'\\\")\""
    }
  ],
  "gate": "proddeploy",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "auto=running\nauto_change=auto-continuity\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"env --split-string='vercel\\\\_--prod'\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "past what the production boundary can read"
      ]
    },
    "stderr": "",
    "events_appended": [
      {
        "event": "prod-deploy-denied",
        "command": "env --split-string='vercel\\_--prod'"
      }
    ]
  }
}
