{
  "name": "teardown gate: Codex SessionEnd cleans fixed-marker state despite a different payload session",
  "source": [
    {
      "assertion": "( cd \"$ELSEWHERE\" && oso-state --session 1 set mode=plan verify_green=true >/dev/null )"
    },
    {
      "assertion": "OSO_AGENT=1 run_hook cleanup-state.sh '{\"session_id\":\"codex-payload-session\"}'"
    },
    {
      "assertion": "assert_after_hook \"Codex SessionEnd cleans fixed-marker state despite a different payload session\" \\\n  [ ! -f \"$elsewhere_state\" ]"
    }
  ],
  "gate": "teardown",
  "argv": [],
  "env": {
    "OSO_AGENT": "1"
  },
  "state_before": {
    ".local/state/oso-code/{sha256:elsewhere-repo}.state": "mode=plan\nverify_green=true\nsession=1\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"codex-payload-session\"}",
  "expect": {
    "exit": 0,
    "state_after": {
      ".local/state/oso-code/{sha256:elsewhere-repo}.state": null
    }
  }
}
