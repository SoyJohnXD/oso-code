{
  "name": "commit gate: a marked call on the repository's red state is denied",
  "source": [
    {
      "assertion": "assert_denies \"the commit gate denies a marked call on the repo's red state\" \\\n  block-commit-until-green.sh \"$(bash_input 'git commit -m x')\""
    }
  ],
  "gate": "commit",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=none\nverify_green=false\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git commit -m x\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "\"permissionDecision\":\"deny\""
      ]
    },
    "stderr": ""
  }
}
