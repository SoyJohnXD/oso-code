{
  "name": "commit gate: a lock file behind flock's option is read, so its commit is denied",
  "source": [
    {
      "assertion": "assert_allows_counted \"residue: a lock file behind flock's option passes\" \\\n  block-commit-until-green.sh \"$(bash_input 'flock -x /tmp/l git commit -m x')\""
    }
  ],
  "gate": "commit",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=plan\nverify_green=false\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"flock -x /tmp/l git commit -m x\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "\"permissionDecision\":\"deny\""
      ]
    },
    "stderr": "",
    "events_appended": [
      {
        "event": "commit-denied",
        "command": "flock -x /tmp/l git commit -m x"
      }
    ]
  }
}
