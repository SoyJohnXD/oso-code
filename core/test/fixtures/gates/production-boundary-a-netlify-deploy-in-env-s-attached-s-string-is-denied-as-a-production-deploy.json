{
  "name": "production boundary: a netlify deploy in env's attached -S string is denied as a production deploy",
  "source": [
    {
      "assertion": "assert_equals \"a netlify deploy in env's attached -S string is denied as a production deploy\" \\\n  \"deny\" \"$(verdict_for \\\"env -S'netlify deploy --prod'\\\")\""
    }
  ],
  "gate": "proddeploy",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "auto=running\nauto_change=auto-continuity\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"env -S'netlify deploy --prod'\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "so a production deploy stays with the operator"
      ]
    },
    "stderr": "",
    "events_appended": [
      {
        "event": "prod-deploy-denied",
        "command": "env -S'netlify deploy --prod'"
      }
    ]
  }
}
