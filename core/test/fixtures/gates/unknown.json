      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"patch\",\"tool_input\":{\"patchText\":\"*** Begin Patch\\n*** Update File: src/a.ts\\n*** Move to: src/b.ts\\n@@\\n-a\\n+b\\n*** End Patch\"}}",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
