{
  "gate": "unknown",
  "cases": [
    {
      "name": "unknown-tool gate: a foreign-owned plan awaiting its slice leaves an unlisted tool alone, as the edits gate does",
      "argv": [
        "--allow",
        "Bash|apply_patch|send_input|resume_agent|close_agent|collaborationspawn_agent|collaborationsend_message|collaborationfollowup_task|collaborationwait_agent|collaborationinterrupt_agent|collaborationlist_agents"
      ],
      "env": {},
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=none\nverify_green=false\nplan_approval=pending\nplan_approval_session=pending-owner-session\nsession=pending-owner-session\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"pending-foreign-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"FutureWriter\",\"tool_input\":{}}",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "unknown-tool gate: a pending belonging to another session does not deny this session's Bash",
      "argv": [
        "--allow",
        "Bash|apply_patch|send_input|resume_agent|close_agent|collaborationspawn_agent|collaborationsend_message|collaborationfollowup_task|collaborationwait_agent|collaborationinterrupt_agent|collaborationlist_agents"
      ],
      "env": {},
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=none\nverify_green=false\nplan_approval=pending\nplan_approval_session=pending-owner-session\nsession=pending-owner-session\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"pending-foreign-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{}}",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "unknown-tool gate: a plan awaiting its slice lets a tool the harness knows through",
      "argv": [
        "--allow",
        "bash|read|grep|engram_mem_search|edit|write|apply_patch"
      ],
      "env": {
        "OSO_HOST": "opencode"
      },
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=none\nverify_green=false\nsession=test-session\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"engram_mem_search\",\"tool_input\":{}}",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "unknown-tool gate: a plan awaiting its slice refuses an unknown tool and names the call that arms the slice",
      "argv": [
        "--allow",
        "bash|read|grep|engram_mem_search|edit|write|apply_patch"
      ],
      "env": {
        "OSO_HOST": "opencode"
      },
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=none\nverify_green=false\nsession=test-session\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"somemcp_do_thing\",\"tool_input\":{}}",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "\"permissionDecision\":\"deny\"",
            "oso-state --session test-session set active_slice="
          ]
        },
        "stderr": ""
      }
    },
    {
      "name": "unknown-tool gate: a release-shaped tool is denied while a state file exists, whatever the mode",
      "argv": [
        "--allow",
        "bash|read|grep|engram_mem_search|edit|write|apply_patch"
      ],
      "env": {
        "OSO_HOST": "opencode"
      },
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=debug\nsession=test-session\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"gh_release_create\",\"tool_input\":{}}",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "\"permissionDecision\":\"deny\"",
            "deploy, publish or release"
          ]
        },
        "stderr": "",
        "events_appended": [
          {
            "event": "release-tool-denied",
            "command": "gh_release_create",
            "session": "test-session",
            "gate": "block-unknown-tool.sh",
            "hook_event": "PreToolUse"
          }
        ]
      }
    },
    {
      "name": "unknown-tool gate: a write into the installed harness tree is denied",
      "argv": [
        "--allow",
        "bash|read|grep|engram_mem_search|edit|write|apply_patch"
      ],
      "env": {
        "OSO_HOST": "opencode",
        "XDG_CONFIG_HOME": "{home}/.config"
      },
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=1\nverify_green=false\nsession=test-session\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"write\",\"tool_input\":{\"file_path\":\"{home}/.config/opencode/skill/x.md\"}}",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "\"permissionDecision\":\"deny\"",
            "installed oso-code harness tree"
          ]
        },
        "stderr": ""
      }
    },
    {
      "name": "unknown-tool gate: an apply_patch whose body names only repository files passes",
      "argv": [
        "--allow",
        "bash|read|grep|engram_mem_search|edit|write|patch"
      ],
      "env": {
        "OSO_HOST": "opencode",
        "XDG_CONFIG_HOME": "{home}/.config"
