    { "file": "tests/hooks-test.sh", "line": 4791, "assertion": "assert_equals \"a turn this hook already continued counts as a push even before any tally exists\" \\\n  \"push push stop\" \"${auto_belt_verdicts# }\"" }
  ],
  "gate": "autocontinue",
  "argv": [],
