{
  "name": "teardown gate: SessionEnd leaves another session's roadmap in flight alone",
  "source": [
    {
      "file": "tests/hooks-test.sh",
      "line": 5740,
      "assertion": "printf 'mode=plan\\nsession=someone-else\\nroadmap=auth-hardening\\n' > \"$roadmap_foreign_state\""
    },
    {
      "file": "tests/hooks-test.sh",
      "line": 5745,
      "assertion": "run_hook cleanup-state.sh '{\"session_id\":\"roadmap-finished\"}'"
    },
    {
      "file": "tests/hooks-test.sh",
      "line": 5746,
      "assertion": "assert_after_hook \"SessionEnd leaves another session's roadmap in flight alone\" \\\n  [ -f \"$roadmap_foreign_state\" ]"
    }
  ],
  "gate": "teardown",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/roadmap-foreign.state": "mode=plan\nsession=someone-else\nroadmap=auth-hardening\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"roadmap-finished\"}",
  "expect": {
    "exit": 0,
    "state_after": {
      ".local/state/oso-code/roadmap-foreign.state": "mode=plan\nsession=someone-else\nroadmap=auth-hardening\n"
    }
  }
}
