{
  "name": "production boundary: a push off the run branch names the run's own branch as the way out",
  "source": [
    {
      "assertion": "assert_equals \"a push that does not name the run branch is denied while the run is in flight\" \\\n  \"deny deny deny\" \\\n  \"$(prod_verdicts_for 'git push origin main' 'git push' 'git -C . push origin main')\""
    }
  ],
  "gate": "proddeploy",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "auto=running\nauto_change=auto-continuity\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git push origin main\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "it pushes its own oso-run/* branch and nothing else"
      ]
    },
    "stderr": "",
    "events_appended": [
      {
        "event": "run-branch-push-denied",
        "command": "git push origin main",
        "session": "test-session",
        "gate": "block-prod-deploy.sh",
        "hook_event": "PreToolUse"
      }
    ]
  }
}
