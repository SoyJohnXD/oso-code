{
  "name": "unknown-tool gate: a release-shaped tool is denied while a state file exists, whatever the mode",
  "source": [
    {
      "assertion": "assert_denies \"a release-shaped tool is denied while a state file exists\" block-unknown-tool.sh \"$(tool_input gh_release_create)\""
    }
  ],
  "gate": "unknown",
  "argv": [
    "--allow",
    "bash|read|grep|engram_mem_search|edit|write|apply_patch"
  ],
  "env": {
    "OSO_HOST": "opencode"
  },
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=debug\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"gh_release_create\",\"tool_input\":{}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "\"permissionDecision\":\"deny\"",
        "deploy, publish or release"
      ]
    },
    "stderr": "",
    "events_appended": [
      {
        "event": "release-tool-denied",
        "command": "gh_release_create",
        "session": "test-session",
        "gate": "block-unknown-tool.sh",
        "hook_event": "PreToolUse"
      }
    ]
  }
}
