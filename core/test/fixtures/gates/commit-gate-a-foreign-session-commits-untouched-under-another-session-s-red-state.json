{
  "name": "commit gate: a session that does not own the red state commits untouched",
  "source": [
    { "assertion": "printf 'mode=plan\\nactive_slice=1\\nverify_green=false\\nsession=owner-session\\n' > \"$REPO_STATE\"" },
    { "assertion": "assert_allows \"the commit gate stays off a session the state does not name as its owner\" block-commit-until-green.sh \"$(bash_input 'git commit -m x')\"" }
  ],
  "gate": "commit",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=1\nverify_green=false\nsession=owner-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"git commit -m x\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": "",
    "stderr": "",
    "events_appended": []
  }
}
