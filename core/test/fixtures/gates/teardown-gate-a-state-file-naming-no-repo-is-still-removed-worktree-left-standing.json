    { "file": "tests/hooks-test.sh", "line": 5882, "assertion": "printf 'mode=plan\\nsession=wt-no-repo\\n' > \"$STATE_DIR/wt-no-repo.state\"" },
    { "file": "tests/hooks-test.sh", "line": 5883, "assertion": "run_hook cleanup-state.sh '{\"session_id\":\"wt-no-repo\"}'" },
    { "file": "tests/hooks-test.sh", "line": 5884, "assertion": "assert_pruned \"a state file naming no repo is still removed\"            \"$STATE_DIR/wt-no-repo.state\"" },
    { "file": "tests/hooks-test.sh", "line": 5885, "assertion": "assert_kept   \"a worktree with no repo to prune in is left where it is\" \"$WORKTREES_DIR/wt-no-repo/1\"" }
  ],
  "gate": "teardown",
  "argv": [],
  "env": {},
