{
  "name": "teardown gate: SessionEnd for an unrelated session leaves another session's pending alone",
  "source": [
    {
      "file": "tests/hooks-test.sh",
      "line": 5713,
      "assertion": "printf 'mode=plan\\nplan_approval=pending\\nsession=orphan-real-session\\nplan_approval_session=orphan-real-session\\n' \\\n  > \"$orphan_pending_state\""
    },
    {
      "file": "tests/hooks-test.sh",
      "line": 5715,
      "assertion": "OSO_AGENT=1 run_hook cleanup-state.sh '{\"session_id\":\"unrelated-session\"}'"
    },
    {
      "file": "tests/hooks-test.sh",
      "line": 5716,
      "assertion": "assert_after_hook \"SessionEnd for an unrelated session leaves another session's pending alone\" \\\n  [ -f \"$orphan_pending_state\" ]"
    }
  ],
  "gate": "teardown",
  "argv": [],
  "env": {
    "OSO_AGENT": "1"
  },
  "state_before": {
    ".local/state/oso-code/orphan-pending.state": "mode=plan\nplan_approval=pending\nsession=orphan-real-session\nplan_approval_session=orphan-real-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"unrelated-session\"}",
  "expect": {
    "exit": 0,
    "state_after": {
      ".local/state/oso-code/orphan-pending.state": "mode=plan\nplan_approval=pending\nsession=orphan-real-session\nplan_approval_session=orphan-real-session\n"
    }
  }
}
