{
  "gate": "reanchor",
  "cases": [
    {
      "name": "reanchor gate: a compacted session with an armed slice is handed back every position source, as session-start context, for an attended run",
      "argv": [],
      "env": {},
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=3\nsession=test-session\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"SessionStart\",\"source\":\"compact\"}",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "\"hookEventName\":\"SessionStart\"",
            "\"additionalContext\"",
            "mem_search oso/index",
            "mem_get_observation",
            "NEXT:",
            "oso-state show",
            "runs/{repo}/run.log",
            "oso-state journal"
          ]
        }
      }
    },
    {
      "name": "reanchor gate: a disarmed slice (active_slice=none) leaves a compaction silent",
      "argv": [],
      "env": {},
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=none\nsession=test-session\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"SessionStart\",\"source\":\"compact\"}",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "reanchor gate: a foreign session's state leaves a compaction silent",
      "argv": [],
      "env": {},
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=3\nsession=test-session\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"another-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"SessionStart\",\"source\":\"compact\"}",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "reanchor gate: a garbage state file leaves a compaction silent",
      "argv": [],
      "env": {},
      "state_before": {
        ".local/state/oso-code/{repo}.state": "this file is not state at all\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"SessionStart\",\"source\":\"compact\"}",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "reanchor gate: a change slug the reader refuses re-anchors on the fallback journal, never on the slug itself",
      "argv": [],
      "env": {},
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=3\nsession=test-session\nauto_change=../escape\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"SessionStart\",\"source\":\"compact\"}",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "runs/{repo}/run.log"
          ]
        }
      }
    },
    {
      "name": "reanchor gate: a SessionStart payload carrying no source field at all stays silent",
      "argv": [],
      "env": {},
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=3\nsession=test-session\nauto=running\nauto_change=auto-continuity\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"SessionStart\"}",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "reanchor gate: a session start whose source is not a compaction stays silent, however live the run is",
      "argv": [],
      "env": {},
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=3\nsession=test-session\nauto=running\nauto_change=auto-continuity\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"SessionStart\",\"source\":\"startup\"}",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "reanchor gate: an unattended run is told to keep going, to park what needs the operator, and where its own journal is",
      "argv": [],
      "env": {},
      "state_before": {
        ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=3\nsession=test-session\nauto=running\nauto_change=auto-continuity\n"
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"SessionStart\",\"source\":\"compact\"}",
      "expect": {
        "exit": 0,
        "stdout": {
          "contains": [
            "continue it now rather than waiting",
            "park it per the",
            "runs/{repo}/auto-continuity.log"
          ]
        }
      }
    },
    {
      "name": "reanchor gate: a state path that is a directory, not a file, leaves a compaction silent",
      "argv": [],
      "env": {},
      "state_before": {
        ".local/state/oso-code/{repo}.state": {
          "kind": "directory"
        }
      },
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"SessionStart\",\"source\":\"compact\"}",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "reanchor gate: no state at all leaves a compaction silent",
      "argv": [],
      "env": {},
      "state_before": {},
      "cwd": "workspace",
      "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"SessionStart\",\"source\":\"compact\"}",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    }
  ]
}
