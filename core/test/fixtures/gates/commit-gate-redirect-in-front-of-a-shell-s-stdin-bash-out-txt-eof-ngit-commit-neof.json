{
  "name": "commit gate, redirect in front of a shell's stdin: bash >out.txt <<EOF\\ngit commit\\nEOF",
  "source": [
    {
      "assertion": "assert_every assert_denies \"redirect in front of a shell's stdin\" <<'REDIRECT_STDIN_TABLE'"
    },
    {
      "assertion": "bash >out.txt <<EOF\\ngit commit\\nEOF"
    }
  ],
  "gate": "commit",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=plan\nverify_green=false\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"bash >out.txt <<EOF\\ngit commit\\nEOF\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "\"permissionDecision\":\"deny\""
      ]
    },
    "stderr": ""
  }
}
