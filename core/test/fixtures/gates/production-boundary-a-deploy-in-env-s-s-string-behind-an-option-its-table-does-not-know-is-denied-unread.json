{
  "name": "production boundary: a deploy in env's -S string behind an option its table does not know is denied unread",
  "source": [
    {
      "assertion": "assert_equals \"a deploy in env's -S string behind an option its table does not know is denied unread\" \\\n  \"deny\" \"$(verdict_for \\\"env --ignore-environment -S'vercel --prod' timeout 5 echo\\\")\""
    }
  ],
  "gate": "proddeploy",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "auto=running\nauto_change=auto-continuity\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"env --ignore-environment -S'vercel --prod' timeout 5 echo\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "past what the production boundary can read"
      ]
    },
    "stderr": "",
    "events_appended": [
      {
        "event": "prod-deploy-denied",
        "command": "env --ignore-environment -S'vercel --prod' timeout 5 echo"
      }
    ]
  }
}
