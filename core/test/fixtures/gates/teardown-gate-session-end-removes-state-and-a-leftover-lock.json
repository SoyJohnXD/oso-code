{
  "name": "teardown gate: session end removes state and a leftover lock",
  "source": [
    { "file": "tests/hooks-test.sh", "line": 5688, "assertion": "run_hook cleanup-state.sh \"$(printf '{\"session_id\":\"%s\"}' \"$SESSION\")\"" },
    { "file": "tests/hooks-test.sh", "line": 5689, "assertion": "assert_after_hook \"session end removes state\"         [ ! -f \"$REPO_STATE\" ]" },
    { "file": "tests/hooks-test.sh", "line": 5690, "assertion": "assert_after_hook \"session end removes leftover lock\" [ ! -d \"$REPO_STATE.lock\" ]" }
  ],
  "gate": "teardown",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=plan\nverify_green=true\nsession=test-session\n",
    ".local/state/oso-code/{repo}.state.lock": { "kind": "directory" }
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\"}",
  "expect": {
    "exit": 0,
    "state_after": {
      ".local/state/oso-code/{repo}.state": null,
      ".local/state/oso-code/{repo}.state.lock": null
    }
  }
}
