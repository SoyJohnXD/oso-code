{
  "name": "production boundary: a deploy behind timeout 10s is denied as a production deploy",
  "source": [
    {
      "assertion": "assert_equals \"a deploy behind timeout 10s is denied as a production deploy\" \\\n  \"deny\" \"$(verdict_for 'timeout 10s vercel deploy --prod')\""
    }
  ],
  "gate": "proddeploy",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "auto=running\nauto_change=auto-continuity\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"timeout 10s vercel deploy --prod\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "so a production deploy stays with the operator"
      ]
    },
    "stderr": "",
    "events_appended": [
      {
        "event": "prod-deploy-denied",
        "command": "timeout 10s vercel deploy --prod"
      }
    ]
  }
}
