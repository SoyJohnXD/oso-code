{
  "gate": "statebin",
  "cases": [
    {
      "name": "statebin gate: no-ops when CLAUDE_ENV_FILE is unset",
      "argv": [],
      "env": {
        "CLAUDE_ENV_FILE": ""
      },
      "state_before": {},
      "cwd": "workspace",
      "stdin": "",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "name": "statebin gate: SessionStart persists OSO_STATE_BIN to an executable",
      "argv": [],
      "env": {
        "CLAUDE_ENV_FILE": "{home}/claude-env-file"
      },
      "state_before": {},
      "cwd": "workspace",
      "stdin": "",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": "",
        "state_after": {
          "claude-env-file": "export OSO_STATE_BIN={repoRoot}/plugin/bin/oso-state"
        }
      }
    }
  ]
}
