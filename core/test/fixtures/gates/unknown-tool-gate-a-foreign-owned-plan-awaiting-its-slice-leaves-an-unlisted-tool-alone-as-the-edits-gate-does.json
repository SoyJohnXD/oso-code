{
  "name": "unknown-tool gate: a foreign-owned plan awaiting its slice leaves an unlisted tool alone, as the edits gate does",
  "source": [
    {
      "assertion": "assert_allows \"a plan another session owns leaves this session's unlisted tool to it, as the edits gate leaves its edit\" block-unknown-tool.sh \"$(tool_input FutureWriter)\""
    }
  ],
  "gate": "unknown",
  "argv": [
    "--allow",
    "Bash|apply_patch|send_input|resume_agent|close_agent|collaborationspawn_agent|collaborationsend_message|collaborationfollowup_task|collaborationwait_agent|collaborationinterrupt_agent|collaborationlist_agents"
  ],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=none\nverify_green=false\nplan_approval=pending\nplan_approval_session=pending-owner-session\nsession=pending-owner-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"pending-foreign-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"FutureWriter\",\"tool_input\":{}}",
  "expect": {
    "exit": 0,
    "stdout": "",
    "stderr": ""
  }
}
