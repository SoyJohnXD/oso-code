{
  "name": "commit gate: git handed its commit verb by xargs outside the green window is denied",
  "source": [
    {
      "assertion": "assert_equals \"git handed its commit verb by xargs outside the green window is denied\" \\\n  \"deny\" \"$(verdict_for \"echo 'commit -m x' | xargs git\")\""
    }
  ],
  "gate": "commit",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=plan\nverify_green=false\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"echo 'commit -m x' | xargs git\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "the session verify is not green"
      ]
    },
    "stderr": "",
    "events_appended": [
      {
        "event": "commit-denied",
        "command": "echo 'commit -m x' | xargs git"
      }
    ]
  }
}
