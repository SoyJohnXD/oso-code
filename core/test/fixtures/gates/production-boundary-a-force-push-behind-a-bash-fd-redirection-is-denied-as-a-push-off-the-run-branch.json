{
  "name": "production boundary: a force push behind a bash {fd} redirection is denied as a push off the run branch",
  "source": [
    {
      "assertion": "assert_equals \"a force push behind a bash {fd} redirection is denied as a push off the run branch\" \\\n  \"deny\" \"$(verdict_for '{fd}>f git push --force origin main')\""
    }
  ],
  "gate": "proddeploy",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "auto=running\nauto_change=auto-continuity\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"{fd}>f git push --force origin main\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "it pushes its own oso-run/* branch and nothing else"
      ]
    },
    "stderr": "",
    "events_appended": [
      {
        "event": "run-branch-push-denied",
        "command": "{fd}>f git push --force origin main"
      }
    ]
  }
}
