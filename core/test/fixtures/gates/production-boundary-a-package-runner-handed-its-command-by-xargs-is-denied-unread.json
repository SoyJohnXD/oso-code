{
  "name": "production boundary: a package runner handed its command by xargs is denied unread",
  "source": [
    {
      "assertion": "assert_equals \"a package runner handed its command by xargs is denied unread\" \\\n  \"deny\" \"$(verdict_for \"printf 'vercel --prod' | xargs npx\")\""
    }
  ],
  "gate": "proddeploy",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "auto=running\nauto_change=auto-continuity\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"permission_mode\":\"default\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"printf 'vercel --prod' | xargs npx\",\"description\":\"regression case\"}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "past what the production boundary can read"
      ]
    },
    "stderr": "",
    "events_appended": [
      {
        "event": "prod-deploy-denied",
        "command": "printf 'vercel --prod' | xargs npx"
      }
    ]
  }
}
