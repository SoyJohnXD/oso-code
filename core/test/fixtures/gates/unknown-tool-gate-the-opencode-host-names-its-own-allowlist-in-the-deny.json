{
  "name": "unknown-tool gate: the OpenCode host names its own allowlist in the deny",
  "source": [
    {
      "file": "tests/hooks-test.sh",
      "line": 1237,
      "assertion": "assert_after_hook \"the Codex catch-all's deny names Codex's own allowlist\" \\\n  hook_deny_names_allowlist_host Codex"
    }
  ],
  "gate": "unknown",
  "argv": [
    "--allow",
    "Bash|apply_patch|send_input|resume_agent|close_agent|collaborationspawn_agent|collaborationsend_message|collaborationfollowup_task|collaborationwait_agent|collaborationinterrupt_agent|collaborationlist_agents"
  ],
  "env": {
    "OSO_HOST": "opencode"
  },
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=1\nverify_green=false\nsession=test-session\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"FutureWriter\",\"tool_input\":{}}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "this release's OpenCode hook allowlist"
      ]
    },
    "stderr": ""
  }
}
