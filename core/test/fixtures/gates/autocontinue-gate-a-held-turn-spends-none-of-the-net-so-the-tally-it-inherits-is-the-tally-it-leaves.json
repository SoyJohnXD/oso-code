{
  "name": "autocontinue gate: a held turn spends none of the net, so the tally it inherits is the tally it leaves",
  "source": [
    { "assertion": "arm_unattended_run\nprintf 'pushes=2\\nheads=\\nauto=running\\n' > \"$AUTO_TALLY\"\nheld_verdict=\"$(auto_stop_verdict \"$(auto_stop_input_with_background_tasks \"$SESSION\" true a1f00d)\")\"" },
    { "assertion": "assert_equals \"a stop allowed with a delegation in flight spends none of the net: the tally it inherits is the tally it leaves\" \\\n  \"stop|pushes=2\" \"$held_verdict|$(head -n 1 \"$AUTO_TALLY\")\"" }
  ],
  "gate": "autocontinue",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "auto=running\nauto_change=auto-continuity\nsession=test-session\n",
    ".local/state/oso-code/runs/{repo}/auto-continuity.pushes": "pushes=2\nheads=\nauto=running\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"Stop\",\"stop_hook_active\":true,\"background_tasks\":[{\"id\":\"a1f00d\",\"type\":\"subagent\",\"status\":\"running\",\"description\":\"applier\",\"agent_type\":\"oso-code:applier\"}]}",
  "expect": {
    "exit": 0,
    "stdout": "{}",
    "stderr": "",
    "state_after": {
      ".local/state/oso-code/runs/{repo}/auto-continuity.pushes": "pushes=2\nheads=\nauto=running\n"
    },
    "events_appended": [
      {
        "event": "auto-continue-watch-unstarted",
        "session": "test-session",
        "command": "background_tasks=array in_flight=1",
        "schema": 2,
        "gate": "auto-continue.sh",
        "hook_event": "Stop"
      }
    ]
  }
}
