{
  "name": "autocontinue gate: a running subagent with no watchdog blocks once with the order to start the watch, and a stale wait label and mark are never called lost",
  "source": [
    { "assertion": "arm_unattended_run\noso-state --session \"$SESSION\" set auto_wait=18 >/dev/null\nage_wait_mark_past_45_minutes\nwatch_verdict=\"$(auto_stop_verdict \"$(auto_stop_input_with_background_tasks \"$SESSION\" false a1f00d)\")\"" },
    { "assertion": "assert_contains \"a delegation in flight with no live watchdog is one block naming the background watch, never a push that calls it lost\" \\\n  \"$watch_verdict\" 'run_in_background' 'watch' && assert_not_contains \"$watch_verdict\" 'lost'" }
  ],
  "gate": "autocontinue",
  "argv": [],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "auto=running\nauto_change=auto-continuity\nsession=test-session\nauto_wait=18\n",
    ".local/state/oso-code/runs/{repo}/test-session.waiting": {
      "kind": "file",
      "content": "run=auto-continuity\nsession=test-session\njournal_bytes=0\nrenewals=0\n",
      "aged": true
    },
    ".claude/projects/oso-code/test-session/subagents/agent-a1f00d.jsonl": "{}\n"
  },
  "cwd": "workspace",
  "stdin": "{\"session_id\":\"test-session\",\"transcript_path\":\"{home}/.claude/projects/oso-code/test-session.jsonl\",\"cwd\":\"{cwd}\",\"hook_event_name\":\"Stop\",\"stop_hook_active\":false,\"background_tasks\":[{\"id\":\"a1f00d\",\"type\":\"subagent\",\"status\":\"running\",\"description\":\"applier\",\"agent_type\":\"oso-code:applier\"}]}",
  "expect": {
    "exit": 0,
    "stdout": {
      "contains": [
        "\"shouldContinue\":true",
        "\"decision\":\"block\"",
        "\\\"${OSO_STATE_BIN:-oso-state}\\\" --session \\\"${CLAUDE_CODE_SESSION_ID}\\\" watch",
        "run_in_background: true",
        "end the turn"
      ]
    },
    "stderr": "",
    "state_after": {
      ".local/state/oso-code/runs/{repo}/test-session.waiting": "run=auto-continuity\nsession=test-session\njournal_bytes=0\nrenewals=0\n",
      ".local/state/oso-code/runs/{repo}/auto-continuity.pushes": "{present}"
    },
    "events_appended": [
      {
        "event": "auto-continue-heads-unreadable",
        "session": "test-session",
        "command": "{present}",
        "schema": 2,
        "gate": "auto-continue.sh",
        "hook_event": "Stop"
      },
      {
        "event": "auto-continue-watch-requested",
        "session": "test-session",
        "command": "background_tasks=array in_flight=1",
        "schema": 2,
        "gate": "auto-continue.sh",
        "hook_event": "Stop"
      }
    ]
  }
}
