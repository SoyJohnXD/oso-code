{
  "name": "set preserves a key it does not name",
  "source": [
    {
      "file": "tests/hooks-test.sh",
      "line": 4531,
      "assertion": "assert_equals \"concurrent writers preserve all keys\" \"a=25 b=25\" \\\n  \"a=$(oso-state --session \"$SESSION\" get a) b=$(oso-state --session \"$SESSION\" get b)\""
    }
  ],
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "a=25\nsession=test-session\n"
  },
  "cwd": "workspace",
  "argv": [
    "--session",
    "test-session",
    "set",
    "b=25"
  ],
  "stdin": "",
  "expect": {
    "exit": 0,
    "state_after": {
      ".local/state/oso-code/{repo}.state": {
        "contains": [
          "a=25",
          "b=25"
        ]
      }
    }
  }
}
