{
  "name": "close-slice refuses when active_slice is none, the sentinel for nothing armed",
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=none\nverify_green=false\nsession=test-session\n"
  },
  "cwd": "workspace",
  "argv": ["--session", "test-session", "close-slice", "3"],
  "stdin": "",
  "expect": {
    "exit": 1,
    "stderr": { "contains": ["close-slice 3 refused", "active_slice is none"] },
    "state_after": {
      ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=none\nverify_green=false\nsession=test-session\n"
    },
    "events_appended": []
  }
}
