{
  "name": "deny-pattern add creates the deploy-deny directory and writes the pattern, naming the file on stdout",
  "env": {},
  "state_before": {},
  "cwd": "workspace",
  "argv": ["--session", "test-session", "deny-pattern", "add", "npm run build"],
  "stdin": "",
  "expect": {
    "exit": 0,
    "stdout": { "contains": ["wrote", "oso-code", "deploy-deny", "{repo}", ".patterns"] },
    "state_after": {
      ".local/state/oso-code/deploy-deny/{repo}.patterns": "npm run build\n"
    },
    "events_appended": [
      { "event": "deny-pattern-add", "command": "npm run build", "session": "{present}" }
    ]
  }
}
