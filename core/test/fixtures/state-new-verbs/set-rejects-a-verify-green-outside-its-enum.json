{
  "name": "set rejects a verify_green that is not true or false",
  "env": {},
  "state_before": {
    ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=3\nverify_green=false\nsession=test-session\n"
  },
  "cwd": "workspace",
  "argv": [
    "--session",
    "test-session",
    "set",
    "verify_green=yes"
  ],
  "stdin": "",
  "expect": {
    "exit": 1,
    "stdout": "",
    "stderr": "oso-state: set refused: verify_green=yes is not one of true, false\n",
    "state_after": {
      ".local/state/oso-code/{repo}.state": "mode=plan\nactive_slice=3\nverify_green=false\nsession=test-session\n"
    },
    "events_appended": []
  }
}
