{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 \"__OSO_HOOKS_DIR__\"/block-commit-until-green.sh"
          }
        ]
      },
      {
        "matcher": "apply_patch|mcp__fallow__fix_apply",
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 \"__OSO_HOOKS_DIR__\"/block-edits-without-slice.sh"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 \"__OSO_HOOKS_DIR__\"/block-unknown-tool.sh --allow \"Bash|apply_patch|update_plan|request_user_input|Agent|spawn_agent|send_input|resume_agent|close_agent|send_message|followup_task|wait_agent|interrupt_agent|list_agents|wait|create_goal|get_goal|update_goal|view_image|list_mcp_resources|list_mcp_resource_templates|read_mcp_resource|image_gen__imagegen|web__run|mcp__engram__mem_search|mcp__engram__mem_get_observation|mcp__engram__mem_save|mcp__engram__mem_update|mcp__context7__resolve-library-id|mcp__context7__query-docs|mcp__fallow__find_dupes|mcp__fallow__get_cleanup_candidates|mcp__fallow__audit|mcp__fallow__fix_apply\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(explorer|oso-applier|oso-verifier|oso-integrator|oso-doubt-pass|oso-debt-sweep|oso-triage|oso-security-reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 \"__OSO_HOOKS_DIR__\"/publish-subagent-handoff.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 \"__OSO_HOOKS_DIR__\"/capture-plan-approval.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 \"__OSO_HOOKS_DIR__\"/approve-plan-token.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 \"__OSO_HOOKS_DIR__\"/warn-stale-state.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 \"__OSO_HOOKS_DIR__\"/cleanup-state.sh"
          }
        ]
      }
    ]
  }
}
