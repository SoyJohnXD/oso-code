{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 node \"__OSO_HOOKS_DIR__\"/gate.js commit"
          }
        ]
      },
      {
        "matcher": "apply_patch|mcp__fallow__fix_apply",
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 node \"__OSO_HOOKS_DIR__\"/gate.js edits"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 node \"__OSO_HOOKS_DIR__\"/gate.js unknown --allow \"Bash|apply_patch|update_plan|request_user_input|Agent|collaborationspawn_agent|collaborationsend_message|collaborationfollowup_task|collaborationwait_agent|collaborationinterrupt_agent|collaborationlist_agents|spawn_agent|send_input|resume_agent|close_agent|send_message|followup_task|wait_agent|interrupt_agent|list_agents|wait|create_goal|get_goal|update_goal|view_image|list_mcp_resources|list_mcp_resource_templates|read_mcp_resource|image_gen__imagegen|image_genimagegen|web__run|mcp__engram__mem_search|mcp__engram__mem_get_observation|mcp__engram__mem_save|mcp__engram__mem_update|mcp__engram__mem_context|mcp__engram__mem_session_summary|mcp__engram__mem_current_project|mcp__engram__mem_save_prompt|mcp__engram__mem_judge|mcp__context7__resolve-library-id|mcp__context7__query-docs|mcp__context7__resolve_library_id|mcp__fallow__find_dupes|mcp__fallow__get_cleanup_candidates|mcp__fallow__audit|mcp__fallow__fix_apply\""
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*deploy.*",
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 node \"__OSO_HOOKS_DIR__\"/gate.js proddeploy"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(explorer|oso-applier|oso-verifier|oso-integrator|oso-doubt-pass|oso-debt-sweep|oso-triage|oso-security-reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 node \"__OSO_HOOKS_DIR__\"/gate.js handoff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 node \"__OSO_HOOKS_DIR__\"/gate.js planstop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 node \"__OSO_HOOKS_DIR__\"/gate.js planprompt"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 node \"__OSO_HOOKS_DIR__\"/gate.js stale"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OSO_AGENT=1 node \"__OSO_HOOKS_DIR__\"/gate.js teardown"
          }
        ]
      }
    ]
  }
}
